{
  "name": "zotero-obsidian-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "A small desktop Obsidian plugin for one-way Zotero imports",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "check": "tsc --noEmit",
    "release": "node scripts/build.mjs && node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "5.9.3"
  }
}
